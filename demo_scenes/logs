#!/usr/bin/env bash
# Read the newest log lines of a hosted agent's Runtime (reads only), 15 minutes if not given.
#   demo_scenes/logs <agent> [minutes]
set -euo pipefail
repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
module=platform_team.agent_monitoring.agent_logs
# The hub's prefix, region and model: the three hub lines of <repo>/.env, as make reads them (README, ".env").
. "$repo/platform_team/shared_code/hub_env.sh"
# The one line of what is called, at most 100 columns.
line="+ python -m $module"
for a in "$@"; do case "$a" in *[[:space:]]*) line+=" \"$a\"" ;; *) line+=" $a" ;; esac; done
[ ${#line} -le 100 ] || line="${line:0:97}..."
echo "$line"
# python -I (isolated): the folder the command is called in never goes on the module search path, and no PYTHON*
# variable of the caller and no user site is read; the hub's modules come from the project's editable install.
exec uv run --quiet --project "$repo" python -I -m "$module" "$@"
