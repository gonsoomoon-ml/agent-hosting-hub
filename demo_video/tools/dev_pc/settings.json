{
  "env": {
    "CLAUDE_CODE_USE_BEDROCK": "1",
    "ANTHROPIC_MODEL": "us.anthropic.claude-sonnet-5-5",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "us.anthropic.claude-haiku-4-5-20251001-v1:0",
    "DISABLE_AUTOUPDATER": "1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "DISABLE_TELEMETRY": "1"
  },
  "awsCredentialExport": "cat /run/dev-pc/bedrock.json",
  "disableAutoMode": "disable",
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "mcp__hub-catalog__*",
      "Edit(./dev_team/**)",
      "Bash(search:*)",
      "Bash(logs:*)",
      "Bash(ls:*)",
      "Bash(cat:*)"
    ],
    "deny": [
      "Read(//run/dev-pc/**)",
      "Edit(./demo_scenes/**)",
      "Edit(./platform_team/**)",
      "Edit(./.claude/**)",
      "Edit(./.mcp.json)",
      "Edit(./pyproject.toml)",
      "Edit(./uv.lock)"
    ]
  },
  "enabledMcpjsonServers": ["hub-catalog"]
}
