{
  "Comment": "Hosting review: Step Functions conducts, CodeBuild handles submitted code, Lambda grants",
  "StartAt": "Read",
  "States": {
    "Read": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": { "FunctionName": "${fn_read}", "Payload.$": "$" },
      "OutputPath": "$.Payload",
      "TimeoutSeconds": 960,
      "Retry": [{ "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"], "IntervalSeconds": 2, "MaxAttempts": 3, "BackoffRate": 2 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Assign": { "failedStep": "Read" }, "Next": "Notify" }],
      "Next": "Reviewable"
    },
    "Reviewable": {
      "Type": "Choice",
      "Comment": "Read gives {skip: <reason>} for a record the review does not host (not an AGENT record, or a harness): the review ends in Skipped, with no alert",
      "Choices": [{ "Variable": "$.skip", "IsPresent": true, "Next": "Skipped" }],
      "Default": "Scan"
    },
    "Skipped": { "Type": "Succeed", "Comment": "Nothing was reviewed or made; the output holds the reason (skip)" },
    "Scan": {
      "Type": "Task",
      "Resource": "arn:aws:states:::codebuild:startBuild.sync",
      "Parameters": {
        "ProjectName": "${scan_project}",
        "EnvironmentVariablesOverride": [
          { "Name": "AGENT", "Value.$": "$.spec.name", "Type": "PLAINTEXT" },
          { "Name": "CODE_KEY", "Value.$": "$.spec.code_key", "Type": "PLAINTEXT" },
          { "Name": "CODE_VERSION", "Value.$": "$.spec.code_version", "Type": "PLAINTEXT" }
        ]
      },
      "ResultSelector": { "buildId.$": "$.Build.Id", "status.$": "$.Build.BuildStatus" },
      "ResultPath": "$.scan",
      "TimeoutSeconds": 1200,
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Assign": { "failedStep": "Scan" }, "Next": "Notify" }],
      "Next": "Grant"
    },
    "Grant": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": { "FunctionName": "${fn_grant}", "Payload.$": "$" },
      "OutputPath": "$.Payload",
      "TimeoutSeconds": 960,
      "Retry": [{ "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"], "IntervalSeconds": 2, "MaxAttempts": 3, "BackoffRate": 2 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Assign": { "failedStep": "Grant" }, "Next": "Notify" }],
      "Next": "Deploy"
    },
    "Deploy": {
      "Type": "Task",
      "Resource": "arn:aws:states:::codebuild:startBuild.sync",
      "Parameters": {
        "ProjectName": "${deploy_project}",
        "EnvironmentVariablesOverride": [
          { "Name": "AGENT", "Value.$": "$.spec.name", "Type": "PLAINTEXT" },
          { "Name": "CODE_KEY", "Value.$": "$.spec.code_key", "Type": "PLAINTEXT" },
          { "Name": "CODE_VERSION", "Value.$": "$.spec.code_version", "Type": "PLAINTEXT" },
          { "Name": "ROLE_ARN", "Value.$": "$.roleArn", "Type": "PLAINTEXT" }
        ]
      },
      "ResultSelector": { "buildId.$": "$.Build.Id", "status.$": "$.Build.BuildStatus" },
      "ResultPath": "$.deploy",
      "TimeoutSeconds": 2100,
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Assign": { "failedStep": "Deploy" }, "Next": "Notify" }],
      "Next": "Entry"
    },
    "Entry": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": { "FunctionName": "${fn_entry}", "Payload.$": "$" },
      "OutputPath": "$.Payload",
      "TimeoutSeconds": 960,
      "Retry": [{ "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"], "IntervalSeconds": 2, "MaxAttempts": 3, "BackoffRate": 2 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Assign": { "failedStep": "Entry" }, "Next": "Notify" }],
      "Next": "TestCall"
    },
    "TestCall": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": { "FunctionName": "${fn_testcall}", "Payload.$": "$" },
      "OutputPath": "$.Payload",
      "TimeoutSeconds": 960,
      "Retry": [{ "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"], "IntervalSeconds": 2, "MaxAttempts": 3, "BackoffRate": 2 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Assign": { "failedStep": "TestCall" }, "Next": "Notify" }],
      "Next": "Approve"
    },
    "Approve": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": { "FunctionName": "${fn_approve}", "Payload.$": "$" },
      "OutputPath": "$.Payload",
      "TimeoutSeconds": 960,
      "Retry": [{ "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"], "IntervalSeconds": 2, "MaxAttempts": 3, "BackoffRate": 2 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Assign": { "failedStep": "Approve" }, "Next": "Notify" }],
      "End": true
    },
    "Notify": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Comment": "The alert: the subject and the message name the step that failed (failedStep, set by its Catch). The message is the review's state with failedStep added; it reads no field of the state by name, so a failed Read (no spec yet) is told too. A publish that fails is tried again, three times at most (Retry), before the review ends without its alert.",
      "Parameters": {
        "TopicArn": "${topic_arn}",
        "Subject.$": "States.Format('Hosting review failed at {}', $failedStep)",
        "Message.$": "States.JsonToString(States.JsonMerge(States.StringToJson(States.Format('\\{\"failedStep\": \"{}\"\\}', $failedStep)), $, false))"
      },
      "Retry": [{ "ErrorEquals": ["States.TaskFailed"], "IntervalSeconds": 5, "MaxAttempts": 3, "BackoffRate": 2 }],
      "Next": "Failed"
    },
    "Failed": { "Type": "Fail", "Error": "ReviewFailed", "Cause": "A step of the hosting review failed; the notification holds the error" }
  }
}
